+# Copyright (c) Microsoft Corporation.
+# SPDX-License-Identifier: Apache-2.0
+
+# DeepSpeed Team
+
+import os
+from contextlib import suppress
+from json import load as load_json
+from pathlib import Path
+
+with suppress(ImportError):
+    import torch_musa
+
+try:
+    # is op_builder from deepspeed or a 3p version? this should only succeed if it's deepspeed
+    # if successful this also means we're doing a local install and not JIT compile path
+    from op_builder import __deepspeed__  # noqa: F401 # type: ignore
+    from op_builder.builder import OpBuilder
+except ImportError:
+    from deepspeed.ops.op_builder.builder import OpBuilder
+
+
+def _get_musa_path():
+    if "MUSA_HOME" in os.environ and os.path.exists(os.environ["MUSA_HOME"]):
+        return os.environ["MUSA_HOME"]
+    return None
+
+
+def _get_musa_version(name=""):
+    musa_path = _get_musa_path()
+    if musa_path is None:
+        message = "MUSA_HOME is not defined, unable to compile MUSA op(s)"
+        raise ValueError(message)
+
+    with Path(musa_path).joinpath("version.json").open("r") as version_file:
+        versions = load_json(version_file)
+
+    return versions["musa_toolkits"]["version"]
+
+
+class MUSAOpBuilder(OpBuilder):
+    _musa_path = None
+    _torch_musa_path = None
+    _musa_version = None
+
+    def __init__(self, name):
+        super().__init__(name)
+        self._musa_path = _get_musa_path()
+        self._torch_musa_path = str(Path(torch_musa.__file__).parent)
+        try:
+            self._musa_version = _get_musa_version(self.name)
+        except Exception:
+            print(f"{self.name} MUSA is missing, ops cannot be compiled!")
+
+    def include_paths(self):
+        paths = super().include_paths()
+        paths += [
+            os.path.join(self._musa_path, "include"),
+            os.path.join(self._torch_musa_path, "include"),
+        ]
+        return paths
+
+    def cxx_args(self):
+        args = super().cxx_args()
+        args += ["-O3", "-std=c++17", "-g", "-Wno-reorder", "-fopenmp"]
+        args += [
+            "-fstack-protector-all",
+            "-Wl,-z,relro,-z,now,-z,noexecstack",
+            "-Wl,--disable-new-dtags,--rpath",
+        ]
+        args += [
+            self.cpu_arch(),
+            self.simd_width(),
+            "-L" + os.path.join(self._musa_path, "lib"),
+            "-L" + os.path.join(self._torch_musa_path, "lib"),
+        ]
+        return args
+
+    def extra_ldflags(self):
+        flags = super().extra_ldflags()
+        flags += [
+            "-L" + os.path.join(self._musa_path, "lib"),
+            "-lmusart",
+            "-L" + os.path.join(self._torch_musa_path, "lib"),
+            "-lmusa_python",
+            "-lmusa_kernels",
+        ]
+        return flags
