+
+#define assert_musa_call(function, ...)                                  \
+  do {                                                                   \
+    auto result = function(__VA_ARGS__);                                 \
+    if (result != musaSuccess) {                                         \
+      std::string error_message(                                         \
+          "assertion failed: expect this call to success but failed: "); \
+      error_message.append(#function);                                   \
+      error_message.append(", code: ");                                  \
+      error_message.append(std::to_string(static_cast<int>(result)));    \
+      C10_THROW_ERROR(ErrorAlwaysShowCppStacktrace, error_message);      \
+    }                                                                    \
+  } while (false)
+
+namespace torch_musa_internal {
+  void submit_noop(musaStream_t stream);
+}
