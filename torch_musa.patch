diff --git a/torch_musa/csrc/aten/ops/musa/ExtraUnaryOps.mu b/torch_musa/csrc/aten/ops/musa/ExtraUnaryOps.mu
new file mode 100644
index 0000000..4f1079d
--- /dev/null
+++ b/torch_musa/csrc/aten/ops/musa/ExtraUnaryOps.mu
@@ -0,0 +1,46 @@
+#define TORCH_ASSERT_NO_OPERATORS
+#include <cmath>
+#include <ATen/Dispatch.h>
+#include <ATen/native/DispatchStub.h>
+#include <ATen/native/Fill.h>
+#include <ATen/native/TensorIterator.h>
+#include <c10/core/Scalar.h>
+#include <ATen/native/musa/Loops.muh>
+
+#include "torch_musa/csrc/aten/utils/Utils.h"
+
+namespace {
+  static constexpr const size_t BlockSize = 256;
+  static inline constexpr size_t get_grid_size(size_t n) { return (n + BlockSize - 1) / BlockSize; }
+}
+
+namespace at::native {
+
+template<typename T>
+__global__ void vectorIsNaN_musa(const T* input, bool* output, size_t n) {
+  int idx = blockIdx.x * blockDim.x + threadIdx.x;
+  if (idx < n) {
+    output[idx] = std::isnan(input[idx]);
+  }
+}
+template __global__ void vectorIsNaN_musa<>(const float* input, bool* output, size_t n);
+template __global__ void vectorIsNaN_musa<>(const double* input, bool* output, size_t n);
+
+template<typename T>
+__global__ void vectorIsInf_musa(const T* input, bool* output, size_t n) {
+  int idx = blockIdx.x * blockDim.x + threadIdx.x;
+  if (idx < n) {
+    output[idx] = std::isinf(input[idx]);
+  }
+}
+template __global__ void vectorIsInf_musa<>(const float* input, bool* output, size_t n);
+template __global__ void vectorIsInf_musa<>(const double* input, bool* output, size_t n);
+
+void is_nan_kernel_musa(const float* input, bool* result, size_t n_elements) {
+  vectorIsNaN_musa<<<get_grid_size(n_elements), BlockSize>>>(input, result, n_elements);
+}
+void is_inf_kernel_musa(const float* input, bool* result, size_t n_elements) {
+  vectorIsInf_musa<<<get_grid_size(n_elements), BlockSize>>>(input, result, n_elements);
+}
+
+} // namespace at::native
